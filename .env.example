# Copy to .env.local and fill in. Never commit .env.local.
# The site runs without any of these — booking, portfolio and admin each
# degrade to a clear message and the WhatsApp fallback until they are set.

# --- Google Calendar (bookings) ---
# SERVICE ACCOUNT ONLY. Do not add an OAuth refresh token: one issued against a
# consent screen in Testing status expires after 7 days and takes booking down
# the week after launch.
#   1. Google Cloud Console -> new project -> enable the Google Calendar API
#   2. Create a service account, add a JSON key, download it
#   3. Paste the whole JSON below on ONE line, in single quotes
#   4. In Google Calendar, share the studio calendar with the service account's
#      client_email, permission "Make changes to events"
#   5. Put that calendar's ID (Settings -> Integrate calendar) in GOOGLE_CALENDAR_ID
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- Cloudinary (portfolio images) ---
# The secret is read only by the server-only modules; it never reaches a browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin (/admin shows client names and phone numbers) ---
# Generate both with:  npm run admin:hash -- "your password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Paystack (booking deposits) ---
# Deposits are OFF until DEPOSIT_GHS in src/lib/constants.ts is greater than
# zero AND this key is set. Use the sk_test_ key first: Paystack's test mode
# gives you working Mobile Money and card flows with no real money moving.
#   Dashboard -> Settings -> API Keys & Webhooks
# The public key is not needed — the redirect flow is initialised server-side.
PAYSTACK_SECRET_KEY=
# Also set the webhook URL in that same dashboard page to:
#   https://<your-domain>/api/paystack/webhook
# Without it, a client who pays and closes the tab loses their booking while
# still being charged.

# --- Feature flags / site ---
# AR try-on is Beta and off by default. Only turn it on after testing on a real
# midrange Android in ordinary indoor light.
NEXT_PUBLIC_ENABLE_AR=false
# Set once the real domain is live, so canonicals and the sitemap use it.
NEXT_PUBLIC_SITE_URL=
